# Normalize text files to LF in the repository
* text=auto

# Force LF for source files
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md    text eol=lf
*.sh    text eol=lf

# Keep Windows endings for PowerShell scripts
*.ps1   text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.jar   binary
*.keystore binary